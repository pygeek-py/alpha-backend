# Copy to .env and fill in. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://alpha:alpha@localhost:5432/alpha

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Data providers -----------------------------------------------------
# "mock" uses fixture-backed data with no external calls or API keys.
# SOLANA_CHAIN_DATA_PROVIDER also accepts "birdeye" (discovery + holder count
# only) or "birdeye_quicknode" (adds real mint/freeze authority + top-holder
# concentration via on-chain RPC -- needs QUICKNODE_RPC_URL below).
# SOLANA_MARKET_DATA_PROVIDER also accepts "birdeye".
SOLANA_CHAIN_DATA_PROVIDER=mock
SOLANA_MARKET_DATA_PROVIDER=mock
SOLANA_WALLET_DATA_PROVIDER=mock
# "none" (default) disables narrative social blending entirely -- narrative
# strength/momentum stay on-chain-only. "mock" exercises the blending code
# path with clearly-labeled simulated data, for local dev/testing only.
SOCIAL_DATA_PROVIDER=none

BIRDEYE_API_KEY=
HELIUS_API_KEY=
# The RPC HTTP Provider URL from your QuickNode dashboard, e.g.
# https://your-endpoint.solana-mainnet.quiknode.pro/sometoken/ -- NOT the
# QN_... account-level API key, which is a different credential.
QUICKNODE_RPC_URL=
TWITTER_BEARER_TOKEN=

# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Free-tier in-process pipeline loop (see apps/core/pipeline.py) -------
# Leave unset/false everywhere except the actual live free-tier Render web
# service's own env vars (set there manually, not via render.yaml -- that
# file describes the real Redis+worker architecture, which must never also
# run this). Starts a background thread (gunicorn.conf.py's
# post_worker_init hook) that continuously runs the pipeline stage by
# stage for as long as the process stays alive, instead of relying on an
# external scheduler to trigger each stage.
PIPELINE_INPROCESS_LOOP=false
